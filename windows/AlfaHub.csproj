<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Alfa Hub para Windows. Apunta a .NET Framework 4.8, que viene instalado en Windows 10/11,
    así que el .exe funciona sin instalar nada. Se puede compilar desde macOS o Linux:
      dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AlfaHub</AssemblyName>
    <RootNamespace>AlfaHub</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AlfaHub.ico</ApplicationIcon>
    <Product>Alfa Hub</Product>
    <AssemblyTitle>Alfa Hub</AssemblyTitle>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="AlfaHub.ico" LogicalName="AlfaHub.AlfaHub.ico" />
    <EmbeddedResource Include="character.png" LogicalName="AlfaHub.character.png" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
